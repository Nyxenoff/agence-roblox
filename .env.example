PORT=3000
NODE_ENV=development

# OAuth Roblox — voir README pour l'enregistrement de l'app
# Remplis ces 2 champs avec les infos de ton app Roblox.
# Pour le test en local, change ROBLOX_REDIRECT_URI en http://localhost:3000/callback.html
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=https://rogrid.vercel.app/callback.html
ROBLOX_SCOPE=openid profile

# Clé secrète pour signer les cookies de session (32+ caractères aléatoires)
SESSION_SECRET=remplacez_par_une_chaine_tres_longue_et_aleatoire
